{
  "compilerOptions": {
    // TypeScript 7 defaults `noImplicitAny` to true for `checkJs`; TypeScript 5 did not.
    // This repo is JSDoc-typed, so keep the historical (looser) behaviour.
    "noImplicitAny": false,
    // Same story for `this`: TypeScript 7 defaults `noImplicitThis` to true for `checkJs`.
    "noImplicitThis": false,
    "target": "ESNext",
    "jsxImportSource": "@jsx6",
    // Tells TypeScript to read JS files, as
    // normally they are ignored as source files
    "allowJs": true,
    // Type check JS via JSDoc annotations (see typescript.notes.md)
    "checkJs": true,
    // Workspace imports resolve through package.json "exports" maps, and DOM types are needed
    // for the browser-facing code.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    // This package type-checks only; it emits no declarations.
    //
    // The `paths` below resolve the workspace packages to their *sources*, so declaration emit
    // would have to write declarations for `libs/jsx6` and `libs/signal` into this package's
    // `outDir` — which TypeScript rejects (TS6059). That was already true under TypeScript 5.9, and
    // `files` in package.json ships `index.js`/`src` only, so no consumer ever saw a `dist/` here.
    "noEmit": true,
    // TypeScript 7 removed `baseUrl`; `paths` alone now resolves relative to this file.
    // vscode does not recognize workspace for some reason
    "paths": {
      "@jsx6/signal": ["../signal/index.js"],
      "@jsx6/jsx6": ["../jsx6/index.js"]
    }
  },
  "include": ["./src/*.js", "./src/**/*.js"],
  "exclude": ["**/*.test.js"]
}
