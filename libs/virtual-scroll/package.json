{
  "name": "@jsx6/virtual-scroll",
  "version": "1.0.0",
  "description": "High-performance virtual scrolling for large lists",
  "main": "index.js",
  "module": "./index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js",
      "require": "./cjs/index.js",
      "default": "./index.js"
    }
  },
  "types": "dist/index.d.ts",
  "unpkg": "esm/index.js",
  "files": [
    "index.js",
    "dist",
    "src",
    "esm",
    "cjs"
  ],
  "scripts": {
    "types": "tsc",
    "build": "esbuild index.js --outdir=esm --bundle --sourcemap --minify --format=esm",
    "build-cjs": "esbuild index.js --outdir=cjs --bundle --sourcemap --minify --format=cjs",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrgdavor/jsx6.git"
  },
  "keywords": [
    "virtual",
    "scroll",
    "scrolling",
    "performance",
    "list"
  ],
  "author": "Davor hrg",
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/hrgdavor/jsx6/blob/master/LICENSE.md"
    }
  ],
  "bugs": {
    "url": "https://github.com/hrgdavor/jsx6/issues"
  },
  "homepage": "https://github.com/hrgdavor/jsx6/blob/master/libs/virtual-scroll/README.md",
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "esbuild": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
