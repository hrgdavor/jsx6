{
  "semi": false,
  "arrowParens": "avoid",
  "printWidth": 110,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "docs",
    "apps/repl/static",
    "*.log",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    "*.pid",
    "*.seed",
    "*.pid.lock",
    "lib-cov",
    "coverage",
    ".nyc_output",
    ".grunt",
    "bower_components",
    ".lock-wscript",
    "build/Release",
    "node_modules/",
    "jspm_packages/",
    ".npm",
    ".eslintcache",
    ".node_repl_history",
    "*.tgz",
    ".yarn-integrity",
    ".env",
    ".next",
    ".DS_Store",
    "*.sublime-workspace",
    ".history",
    ".tmp",
    "esm",
    "cjs",
    "deploy",
    "dist",
    "build",
    "build_dev",
    "coverage",
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "shrinkwrap.json",
    "lib",
    "*.md"
  ]
}
