# Normalize line endings in the working tree; repositories are checked out with LF.
* text=auto eol=lf

# Binary files that must never be line-ending normalized.
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.map binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Lockfiles: keep real content, but never attempt a textual merge of them.
bun.lock           merge=binary
pnpm-lock.yaml     merge=binary
yarn.lock          merge=binary
package-lock.json  merge=binary