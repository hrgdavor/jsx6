    "docs:check": "bun run scripts/check-docs.js"
  },
  "workspaces": [
    "libs/*",
    "apps/*",
    "tools/*"
  ],
  "catalog": {
    "esbuild": "^0.17.18",
    "typescript": "^5.0.4",
    "prettier": "~2.7.1",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "@happy-dom/global-registrator": "~14.7.1",
    "happy-dom": "~14.7.1",
    "bun-types": "~1.0.24",
    "@types/node": "^20.19.9",
    "live-server": "^1.2.2",
    "@types/bun": "~1.0.2",
    "@trivago/prettier-plugin-sort-imports": "~3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}