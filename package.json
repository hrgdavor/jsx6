{
  "name": "jsx6-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "test": "bun run scripts/verify.js --tests-only",
    "check": "bun run scripts/verify.js",
    "check:fast": "bun run scripts/verify.js --quick",
    "lint": "oxlint libs tools scripts --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "bump": "bun run scripts/versions.js",
    "pub": "bun run scripts/publish.js --public",
    "check-versions": "bun run scripts/check-versions.js",
    "docs:build": "bun run scripts/build-docs.js",
    "docs:check": "bun run scripts/check-docs.js",
    "docs:inject": "bunx @hrg/inject-examples libs/signal/doc/computed",
    "docs:inject:check": "bunx @hrg/inject-examples --check libs/signal/doc/computed"
  },
  "workspaces": [
    "libs/*",
    "apps/*",
    "tools/*"
  ],
  "catalog": {
    "esbuild": "^0.17.18",
    "typescript": "^5.0.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "alien-signals": "^3.2.1",
    "@happy-dom/global-registrator": "~14.7.1",
    "happy-dom": "~14.7.1",
    "bun-types": "~1.0.24",
    "@types/node": "^20.19.9",
    "live-server": "^1.2.2",
    "@types/bun": "~1.0.2"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  }
}
